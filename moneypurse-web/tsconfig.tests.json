{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "outDir": "dist-tests",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["lib/**/*.ts", "hooks/**/*.ts", "components/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
}
