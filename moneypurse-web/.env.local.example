NEXT_PUBLIC_LEDGER_API_URL=http://localhost:3000
NEXT_PUBLIC_SECURITY_API_URL=http://localhost:3200

# Supabase add-on identity layer (customer sign-up/login + email OTP). Both are PUBLIC browser
# values: the anon key is designed to be shipped to the client. Leave unset to disable the Supabase
# sign-up/login paths. The ledger-service must have the matching SUPABASE_URL to accept its tokens.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
