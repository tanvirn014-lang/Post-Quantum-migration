# Copy to .env (or run `npm run setup` at the repository root, which also generates secrets).
NODE_ENV=development
HOST=0.0.0.0
PORT=3200

# Separate database from ledger-service (created automatically by `npm run migrate`).
DATABASE_URL=postgres://ledger:ledger@localhost:5432/security

CORS_ORIGIN=http://localhost:3100

# Access tokens are verified against ledger-service's published public key. No secret is shared.
JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=pq-bank-ledger-service
JWT_AUDIENCE=pq-bank-platform

# Machine-to-machine bearer tokens (min 32 chars). Generated by `npm run setup`.
# SIDECAR_TOKEN=
# BENCH_TOKEN=

# Optional: peer simulator used to run experiment scenarios from the API.
# PEER_SIM_URL=http://localhost:3300
# PEER_SIM_TOKEN=

# SIDECAR_STALE_SECONDS=45
# RATE_LIMIT_MAX=300
