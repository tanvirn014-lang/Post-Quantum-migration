{
  "name": "security-service",
  "version": "0.1.0",
  "description": "Control plane for the hybrid post-quantum migration prototype: peer registry, TLS profile / crypto-provider configuration, policy telemetry, CBOM, HNDL simulator and benchmark store.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "dev": "node --env-file-if-exists=.env --watch dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/index.test.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "migrate": "npm run build && node --env-file-if-exists=.env dist/src/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "pg": "^8.13.1",
    "pino-pretty": "^11.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
