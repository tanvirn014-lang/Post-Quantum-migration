{
  "name": "ledger-service",
  "version": "0.1.0",
  "description": "Core double-entry ledger and account service for the digital banking platform (Bangladesh MVP)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "node --watch dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/index.test.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "migrate": "npm run build && node dist/src/adapters/postgres/migrate.js"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.13.1",
    "zod": "4.6.7",
    "pino-pretty": "11.2.2"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "typescript": "5.6.3"
  }
}
