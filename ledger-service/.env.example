# Copy to .env (or run `npm run setup` at the repository root, which also generates secrets).
# Real secrets never belong in this file or in git.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# "memory" is for throwaway local runs only; production refuses it.
LEDGER_STORE=postgres
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger

# Comma-separated allow-list of browser origins. Wildcards are rejected (credentials are in use).
CORS_ORIGIN=http://localhost:3100

# Ed25519 signing key (PKCS#8 PEM) for access tokens. Generated by `npm run setup`.
JWT_PRIVATE_KEY_FILE=.secrets/jwt-ed25519.pem
# Signing-key rotation: comma-separated SPKI PEM file paths of PREVIOUS public keys to keep in the
# JWKS for verification during a rotation window. To rotate: make a new key the active
# JWT_PRIVATE_KEY_FILE, list the old public key here, then remove it after ACCESS_TOKEN_TTL_SECONDS.
# JWT_ADDITIONAL_PUBLIC_KEY_FILES=.secrets/jwt-ed25519-prev.pub.pem
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=7

# Optional hardening knobs (defaults shown).
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# RATE_LIMIT_MAX=300
# LOGIN_RATE_LIMIT_MAX=10
# COOKIE_SECURE=false   # defaults to true in production

# Shared with pqc-sidecar (min 32 chars). Unset disables the partner API.
# SIDECAR_ASSERTION_SECRET=

# Supabase add-on identity layer (optional). When set, the core also accepts Supabase-issued
# access tokens, verified against the project's public JWKS (asymmetric ES256 keys), and provisions
# a local customer for them. Use the project BASE url (no /rest/v1). No secret or service-role key
# is needed. Unset disables the add-on. See docs/DEMO_RUNBOOK.md section 7 for dashboard setup.
# SUPABASE_URL=https://<ref>.supabase.co
# Expected audience on Supabase access tokens (user tokens use "authenticated"). Default shown.
# SUPABASE_AUDIENCE=authenticated
# Auto-provision a local customer for an unseen Supabase identity. OFF by default (an unseen
# identity is refused unless an operator pre-created the customer, which is then linked). The
# self-service sign-up demo requires this ON. See docs/DEMO_RUNBOOK.md section 7.
# SUPABASE_AUTO_PROVISION=false
