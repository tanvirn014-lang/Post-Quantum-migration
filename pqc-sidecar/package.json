{
  "name": "pqc-sidecar",
  "version": "0.1.0",
  "description": "Hybrid post-quantum TLS 1.3 perimeter sidecar (X25519MLKEM768), per-peer fallback policy, peer simulator, tamper proxy and benchmark harness.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:simulator": "node --env-file-if-exists=.env dist/src/peers/simulator-main.js",
    "pki": "npm run build && node --env-file-if-exists=.env dist/src/pki/cli.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/index.test.js",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@peculiar/x509": "^1.14.3",
    "pino": "^9.14.0",
    "pino-pretty": "^11.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
