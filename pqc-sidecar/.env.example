# Copy to .env, or run `npm run setup` at the repository root (it generates the shared secrets and the PKI).
NODE_ENV=development
LOG_LEVEL=info

# TLS 1.3 listener for partner peers. Binds to loopback by default.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8443
# Loopback-only plain-HTTP status endpoint (/healthz, /status).
SIDECAR_ADMIN_PORT=8081

# Server certificate/key and the CA that issues peer client certificates (generated by `npm run pki`).
TLS_KEY_FILE=.secrets/pki/sidecar/server.key.pem
TLS_CERT_FILE=.secrets/pki/sidecar/server.pem
PEER_CA_FILE=.secrets/pki/ca.pem

# The core. Plain HTTP on a private network is the documented prototype boundary: post-quantum
# protection of key establishment ends at this sidecar.
UPSTREAM_URL=http://localhost:3000
SECURITY_SERVICE_URL=http://localhost:3200

# Shared secrets (min 32 chars), generated by `npm run setup`:
#   SIDECAR_TOKEN              must equal security-service's SIDECAR_TOKEN
#   SIDECAR_ASSERTION_SECRET   must equal ledger-service's SIDECAR_ASSERTION_SECRET
#   PEER_SIM_TOKEN             must equal security-service's PEER_SIM_TOKEN (peer simulator only)

# Peer simulator (separate process; holds the simulated peers' private keys).
PEER_SIM_PORT=3300
PKI_DIR=.secrets/pki

# CONFIG_POLL_MS=5000
# HEARTBEAT_MS=10000
# MAX_CONNECTIONS=200
# HANDSHAKE_TIMEOUT_MS=10000
